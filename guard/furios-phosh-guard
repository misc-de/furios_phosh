#!/bin/sh
# SPDX-FileCopyrightText: Copyright (c) 2026 misc-de
# SPDX-License-Identifier: MIT
#
# Takes our plugins out of phosh when phosh keeps dying, so the phone falls
# back to the shell as it shipped instead of having none.
#
# Our plugins are built against one phosh and loaded into whatever phosh a
# FuriLabs update brings. phosh checks no version before loading them, and a
# plugin that no longer fits takes the shell down with it. The shell unit
# restarts three times in 15 s and then ends the session; phosh.service
# starts a new one five seconds later, and the phone loops without a UI.
#
# Run as ExecStartPre of mobi.phosh.Shell.service (with "-", so nothing here
# can keep the shell from starting), and as its ExecStopPost with "stopped",
# which writes down how the shell ended ($SERVICE_RESULT). Two starts less
# than WINDOW seconds apart, the shell in between having died of a signal
# (a crash, an abort) or ended with no record at all, mean the one before did
# not survive: every furios-* name comes out of the plugin lists, and what
# was there is kept to be put back by hand once the plugins are rebuilt:
#
#     furios-phosh-guard restore
#
# A shell that was stopped (`systemctl restart phosh`, a logout) ends with
# "success"; one that exited on its own with a status ("exit-code" - it lost
# its display) did not crash either. Neither is counted, however quickly the
# next start follows: two restarts by hand are not a plugin that no longer
# fits.
#
# Only our names are touched. The shipped plugins stay as they were.
set -u

WINDOW=${FURIOS_PHOSH_GUARD_WINDOW:-60}
STATE=${FURIOS_PHOSH_GUARD_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/furios-phosh-guard}
SCHEMA=mobi.phosh.shell.plugins
KEYS="status-icons plugins"
GSETTINGS=${FURIOS_PHOSH_GUARD_GSETTINGS:-gsettings}

log() {
    printf 'furios-phosh-guard: %s\n' "$*" >&2
    command -v logger >/dev/null 2>&1 && logger -t furios-phosh-guard "$*"
    return 0
}

# A gsettings list without our names: ['a', 'furios-b', 'c'] -> ['a', 'c'].
without_ours() {
    printf '%s\n' "$1" | tr -d '[]' | tr ',' '\n' \
        | sed "s/^[[:space:]]*//; s/[[:space:]]*\$//; s/^@as //" \
        | grep -v "^'furios-" | grep -v '^$' | paste -sd, - \
        | sed 's/,/, /g; s/^/[/; s/$/]/'
}

disable() {
    local key cur new took=0
    for key in $KEYS; do
        cur=$($GSETTINGS get "$SCHEMA" "$key" 2>/dev/null) || continue
        case "$cur" in *"'furios-"*) ;; *) continue ;; esac
        new=$(without_ours "$cur")
        [ "$new" = "[]" ] && new="@as []"
        # Kept before it is changed, and never overwritten by a later loop:
        # the first list saved is the one somebody chose.
        [ -e "$STATE/$key" ] || printf '%s\n' "$cur" > "$STATE/$key"
        if $GSETTINGS set "$SCHEMA" "$key" "$new" 2>/dev/null; then
            # And what we wrote in its place, read back the way gsettings
            # prints it: restore compares the list with this, so it only
            # undoes our own change - see restore().
            $GSETTINGS get "$SCHEMA" "$key" > "$STATE/$key.ours" 2>/dev/null \
                || printf '%s\n' "$new" > "$STATE/$key.ours"
            log "phosh restarted within ${WINDOW}s - took our plugins out of $key (was: $cur)"
            took=1
        fi
    done
    [ "$took" = 1 ] && date '+%F %T' > "$STATE/disabled"
    return 0
}

# Puts back the list the guard took our names out of - but only where the
# list is still the one the guard wrote. Somebody who changed it since (added
# a plugin, took one out by hand) made a choice after ours, and writing the
# old list over it would undo that choice without a word. Then the saved list
# is kept, printed, and left for them to put back by hand.
#
# The key was necessarily SET when the guard acted: a list with furios-* names
# in it is never phosh's default, so writing the saved value back is exact -
# there is no "unset" to lose here. (What the phone had before the plugins
# were installed is a different record, furios-phosh-original's, and the
# uninstallers go back to that one.)
restore() {
    local key done_any=0 cur ours
    for key in $KEYS; do
        [ -r "$STATE/$key" ] || continue
        cur=$($GSETTINGS get "$SCHEMA" "$key" 2>/dev/null) || cur=
        ours=$(cat "$STATE/$key.ours" 2>/dev/null) || ours=
        if [ -n "$ours" ] && [ "$cur" != "$ours" ]; then
            echo "$key was changed since the guard took our plugins out - left as it is."
            echo "  now:   $cur"
            echo "  saved: $(cat "$STATE/$key")"
            echo "  put it back by hand with: gsettings set $SCHEMA $key \"$(cat "$STATE/$key")\""
            done_any=1
            continue
        fi
        if $GSETTINGS set "$SCHEMA" "$key" "$(cat "$STATE/$key")"; then
            rm -f "$STATE/$key" "$STATE/$key.ours"
            echo "restored $key"
            done_any=1
        fi
    done
    # The mark goes only once nothing is left to put back.
    ls "$STATE"/*.ours >/dev/null 2>&1 || rm -f "$STATE/disabled"
    [ "$done_any" = 1 ] || echo "nothing to restore"
    return 0
}

mkdir -p "$STATE" 2>/dev/null || exit 0

# Within one boot only: a phone switched off and on again quickly starts the
# shell twice in a minute too, and that is not a crash.
BOOT_ID=${FURIOS_PHOSH_GUARD_BOOT_ID:-$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)}

case "${1:-check}" in
restore) restore; exit 0 ;;
stopped)
    # From ExecStopPost, after every end of the shell - a crash included,
    # since systemd runs it whatever became of the main process.
    printf '%s %s\n' "$BOOT_ID" "${SERVICE_RESULT:-}" > "$STATE/last-stop"
    exit 0 ;;
status)
    if [ -e "$STATE/disabled" ]; then
        echo "disabled since $(cat "$STATE/disabled") - phosh kept restarting"
    else
        echo "not triggered"
    fi
    exit 0 ;;
check) ;;
*) echo "usage: furios-phosh-guard [check|status|restore|stopped]" >&2; exit 2 ;;
esac

now=$(date +%s)
# How the shell before this start ended - read once, then gone, so it is
# never taken for the end of a later one. No record (a guard from before
# this was written, or an end systemd never saw) counts as a crash, as it
# always did.
read -r stop_boot stop_result < "$STATE/last-stop" 2>/dev/null || { stop_boot=; stop_result=; }
rm -f "$STATE/last-stop"

read -r last_boot last < "$STATE/last-start" 2>/dev/null || { last_boot=; last=; }
printf '%s %s\n' "$BOOT_ID" "$now" > "$STATE/last-start"
case "$last" in ''|*[!0-9]*) exit 0 ;; esac
[ "$last_boot" = "$BOOT_ID" ] || exit 0
if [ "$stop_boot" = "$BOOT_ID" ]; then
    case "$stop_result" in
    success|exit-code) exit 0 ;;
    esac
fi
[ $((now - last)) -lt "$WINDOW" ] && disable
exit 0
